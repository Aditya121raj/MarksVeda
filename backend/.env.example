# MarksVeda Backend — Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/marksveda?retryWrites=true&w=majority

# Server port (platforms like Render set this automatically)
PORT=5000

# Admin panel password (change before going live!)
ADMIN_PASSWORD=admin123
